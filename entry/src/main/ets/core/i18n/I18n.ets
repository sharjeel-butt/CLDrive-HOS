// =============================================================================
// Registry
// =============================================================================

const REGISTRY: Map<string, TranslationMap> = new Map<string, TranslationMap>([
  ['en',      EN],
  ['zh-Hans', ZH_HANS],
  ['ar',      AR],
  ['es',      ES]
]);

// =============================================================================
// Runtime
// =============================================================================

let currentLang: LangCode = 'en';
let currentMap: TranslationMap = EN;

export function setRuntimeLanguage(code: LangCode): void {
  currentLang = code;
  const m: TranslationMap | undefined = REGISTRY.get(code);
  currentMap = m !== undefined ? m : EN;
}

export function getRuntimeLanguage(): LangCode {
  return currentLang;
}

/**
 * Resolve a key to a definite string. Falls back to English if the
 * key is missing in the active language, then to the key itself so
 * nothing renders as an empty string.
 */
function resolveKey(key: string): string {
  const active: string | undefined = currentMap.get(key);
  if (active !== undefined) return active;
  const fallback: string | undefined = EN.get(key);
  if (fallback !== undefined) return fallback;
  return key;
}

/**
 * Translate a key. Positional substitution:
 *   t('fb.deletedN', '3')  →  "Deleted 3 items"
 * The first substitute replaces {name}, the second replaces {n}.
 */
export function t(key: string, ...subs: string[]): string {
  let out: string = resolveKey(key);
  for (let i = 0; i < subs.length; i++) {
    const placeholder: string = i === 0 ? 'name' : 'n';
    out = out.replace(`{${placeholder}}`, subs[i]);
  }
  return out;
}

/**
 * Translate with named substitution. Callers pass a Map of
 * placeholder → value, e.g. new Map([['name', 'photo.jpg']]).
 */
export function tNamed(key: string, subs: Map<string, string>): string {
  let out: string = resolveKey(key);
  const keys: string[] = [];
  subs.forEach((_value: string, k: string): void => {
    keys.push(k);
  });
  for (let i = 0; i < keys.length; i++) {
    const k: string = keys[i];
    const value: string | undefined = subs.get(k);
    if (value !== undefined) {
      out = out.replace(`{${k}}`, value);
    }
  }
  return out;
}

/**
 * Detect the closest supported language from the system locale.
 */
export function detectSystemLanguage(): LangCode {
  try {
    const sys: string = i18n.System.getSystemLanguage();
    const lower: string = sys.toLowerCase();

    if (lower.startsWith('zh')) {
      const region: string = i18n.System.getSystemRegion();
      return (region === 'TW' || region === 'HK' || region === 'MO')
        ? 'zh-Hant' : 'zh-Hans';
    }
    if (lower.startsWith('ar')) return 'ar';
    if (lower.startsWith('es')) return 'es';
    if (lower.startsWith('fr')) return 'fr';
    if (lower.startsWith('de')) return 'de';
    if (lower.startsWith('it')) return 'it';
    if (lower.startsWith('ja')) return 'ja';
    if (lower.startsWith('ko')) return 'ko';
    if (lower.startsWith('ru')) return 'ru';
    if (lower.startsWith('pt')) return 'pt';
    if (lower.startsWith('tr')) return 'tr';
    if (lower.startsWith('th')) return 'th';
    if (lower.startsWith('vi')) return 'vi';
    if (lower.startsWith('id')) return 'id';
    if (lower.startsWith('ms')) return 'ms';
    if (lower.startsWith('pl')) return 'pl';
    if (lower.startsWith('ug')) return 'ug';
    if (lower.startsWith('bo')) return 'bo';
    if (lower.startsWith('lo')) return 'lo';
    if (lower.startsWith('my')) return 'my';
    return 'en';
  } catch (e) {
    const err: Error = e as Error;
    console.warn('detectSystemLanguage failed: ' + err.message);
    return 'en';
  }
}